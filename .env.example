# Used by docker-compose.yml to set the Postgres container's password.
# Docker Compose auto-loads this from a file literally named .env (not .env.local).
POSTGRES_PASSWORD=

# Used by the Next.js app (put this in .env.local, not .env).
DATABASE_URL=postgres://tazkz:<POSTGRES_PASSWORD, URL-encoded>@localhost:5432/tazkz

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
